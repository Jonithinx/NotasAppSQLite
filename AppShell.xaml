<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NotasAppSQLite.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:NotasAppSQLite.Views"
    Title="NotasApp">

    <TabBar>
        <Tab Title="Notas" Route="NotasTab">
            <ShellContent
                Title="Notas"
                ContentTemplate="{DataTemplate views:NotasPage}"
                Route="NotasPage" />
        </Tab>

        <Tab Title="Historial" Route="HistorialTab">
            <ShellContent
                Title="Historial"
                ContentTemplate="{DataTemplate views:HistorialPage}"
                Route="HistorialPage" />
        </Tab>
    </TabBar>

</Shell>
