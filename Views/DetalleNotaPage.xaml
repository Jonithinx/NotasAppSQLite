<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NotasAppSQLite.ViewModels"
             x:Class="NotasAppSQLite.Views.DetalleNotaPage"
             x:DataType="vm:DetalleNotaViewModel"
             Title="{Binding Id, Converter={x:Null}, StringFormat='Nota'}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Encabezado informativo -->
            <Label Text="Detalles de la Nota"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#512BD4" />

            <!-- Campo Título -->
            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="Título"
                           FontSize="14"
                           FontAttributes="Bold" />
                    <Label Text="*"
                           TextColor="Red"
                           FontAttributes="Bold" />
                    <Label Text="(máximo 100 caracteres)"
                           FontSize="12"
                           TextColor="Gray"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border StrokeShape="RoundRectangle 8"
                        Stroke="{Binding TieneErrorTitulo, Converter={x:Null}}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#2A2A2A}">
                    <Entry Text="{Binding Titulo, Mode=TwoWay}"
                           Placeholder="Escribe el título aquí..."
                           MaxLength="105"
                           ClearButtonVisibility="WhileEditing"
                           Margin="10,0" />
                </Border>

                <!-- Aviso visual de error -->
                <Label Text="{Binding ErrorTitulo}"
                       TextColor="#D32F2F"
                       FontSize="12"
                       FontAttributes="Italic"
                       IsVisible="{Binding TieneErrorTitulo}" />
            </VerticalStackLayout>

            <!-- Campo Contenido -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Contenido"
                       FontSize="14"
                       FontAttributes="Bold" />

                <Border StrokeShape="RoundRectangle 8"
                        Stroke="#BDBDBD"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#2A2A2A}"
                        HeightRequest="260">
                    <Editor Text="{Binding Contenido, Mode=TwoWay}"
                            Placeholder="Escribe las notas, recordatorios o detalles aquí..."
                            AutoSize="Disabled"
                            Margin="10,8" />
                </Border>
            </VerticalStackLayout>

            <!-- Botón Guardar -->
            <Button Text="💾 Guardar Nota"
                    Command="{Binding GuardarNotaCommand}"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="52"
                    Margin="0,12,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
